{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // knip's Vite plugin finds the renderer entry through build/vite/renderer.config.ts,
  // but not the main and preload library entries, so those two are listed here.
  "entry": ["src/main/index.ts", "src/preload/index.ts", "shared/types.ts"],
  "project": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/renderer/**/*.{ts,svelte,css}",
    "shared/**/*.ts",
    "build/vite/**/*.ts",
  ],
  "paths": {
    "$shared/*": ["./shared/*"],
    "$lib/*": ["./src/renderer/src/lib/*"],
    "$paraglide/*": ["./src/renderer/src/paraglide/*"],
  },
}

{
  "name": "birda-gui",
  "version": "1.2.1",
  "description": "Desktop GUI for the birda bird species detection CLI",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "prebuild": "tsx scripts/fetch-birda-cli.ts",
    "build": "vite build -c build/vite/main.config.ts && vite build -c build/vite/preload.config.ts && vite build -c build/vite/renderer.config.ts && node --check out/main/index.js && node --check out/preload/index.cjs && node scripts/check-paraglide-output.js",
    "preview": "npm run build && electron .",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/renderer/src/paraglide --output-structure locale-modules && node scripts/check-paraglide-output.js",
    "precheck": "npm run paraglide",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prelint": "npm run paraglide",
    "lint": "eslint . && svelte-check --tsconfig ./tsconfig.json",
    "prelint:fix": "npm run paraglide",
    "lint:fix": "eslint --fix .",
    "preknip": "npm run paraglide",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "pretest": "npm run paraglide",
    "test": "vitest run",
    "validate:translations": "node scripts/validate-translations.js",
    "validate": "npm run paraglide && npm run format:check && npm run --ignore-scripts lint && npm run typecheck && npm run --ignore-scripts test && npm run --ignore-scripts knip && npm run validate:translations && npm audit --omit=dev",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "prepare": "husky"
  },
  "homepage": "https://github.com/tphakala/birda-gui",
  "repository": {
    "type": "git",
    "url": "https://github.com/tphakala/birda-gui.git"
  },
  "keywords": [],
  "author": "Tomi P. Hakala <tphakala@users.noreply.github.com>",
  "license": "Apache-2.0",
  "birdaCli": {
    "version": "1.8.1",
    "repo": "tphakala/birda"
  },
  "build": {
    "compression": "normal",
    "npmRebuild": false,
    "appId": "com.birda.gui",
    "productName": "Birda GUI",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      },
      {
        "from": "resources/birda-cli/",
        "to": "birda-cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "artifactName": "Birda-GUI-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Birda-GUI-${version}-windows-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "Birda-GUI-${version}-macos-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Birda-GUI-Setup-${version}-windows-${arch}.${ext}"
    }
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^13.0.2",
    "daisyui": "^5.6.6",
    "music-metadata": "^11.16.1",
    "suncalc": "^2.0.0",
    "wavesurfer.js": "^7.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.10.0",
    "@lucide/svelte": "^1.7.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/svelte": "^5.0.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.7.0",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.1.0",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "knip": "^6.3.0",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.11.2",
    "prettier": "^3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.6",
    "svelte-maplibre-gl": "^2.0.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,svelte,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{*.{jsonc,md,css,html,yml,yaml},.prettierrc}": [
      "prettier --write"
    ]
  }
}
